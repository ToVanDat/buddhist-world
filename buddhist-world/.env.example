# Copy to .env and generate a unique secret for every environment. NEVER commit .env.
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://bw:bw_dev_password@localhost:5432/buddhist_world
REDIS_URL=redis://localhost:6379
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# This placeholder is intentionally invalid for production. Replace it in your local .env.
JWT_ACCESS_SECRET=CHANGE_ME_generate_a_unique_random_secret_at_least_32_chars
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000
COOKIE_SECURE=false

# Optional: GLB character model with Idle/Walk/Run/Jump animation clips.
# Example: /assets/characters/player.glb (leave blank to use procedural placeholder).
VITE_PLAYER_MODEL_URL=
