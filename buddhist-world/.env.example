# Buddhist World environment template
# Copy to .env for local development. Never commit .env or production secrets.

# Runtime
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Local Docker Compose: infra/docker-compose.dev.yml
# Host port 5433 maps to container port 5432.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/buddhist_world
REDIS_URL=redis://localhost:6379

# Authentication
# Password recovery email (Resend), matching Student-Manager configuration.
# Keep all values server-side; never use VITE_ prefixes.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
PASSWORD_RESET_OTP_TTL_SEC=300
PASSWORD_RESET_TOKEN_TTL_SEC=600
# Generate a unique value: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# This placeholder is intentionally invalid for production.
JWT_ACCESS_SECRET=CHANGE_ME_generate_a_unique_random_secret_at_least_32_chars
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000
COOKIE_SECURE=false

# Realtime
SOCKET_OWNER_LEASE_MS=30000

# Authoritative world weather; visual weather particles are a separate client effect.
WORLD_WEATHER=clear
WORLD_WEATHER_INTENSITY=0

# Optional frontend assets (Vite reads the root workspace .env via apps/web/vite.config.ts).
# Leave blank until the corresponding approved assets are available.
VITE_PLAYER_MODEL_URL=
VITE_NPC_MODEL_URL=
VITE_WORLD_AMBIENCE_URL=
VITE_WORLD_INTRO_VIDEO_URL=

# Prayer experience — provide a recording that you own or are licensed to use.
# This URL is public frontend configuration, not a secret. Do not put private credentials here.
# Supported formats depend on the browser (MP3/OGG/WAV are common).
VITE_PRAYER_AUDIO_URL=
VITE_PRAYER_AUDIO_TITLE=Nam Mo A Di Da Phat

# WebRTC TURN — intentionally disabled until the dedicated Buddhist World TURN VPS is provisioned.
# When ready, use turn-bw.smartsmanage.com and a Buddhist-World-only shared secret.
# Keep TURN_SHARED_SECRET server-side only; never use a VITE_ prefix for secrets.
TURN_URLS=
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SEC=600

# Local LiveKit development only
LIVEKIT_INTERNAL_URL=http://localhost:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_TOKEN_TTL_SEC=60
