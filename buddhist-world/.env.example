# Copy to .env and generate a unique secret for every environment. NEVER commit .env.
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://bw:bw_dev_password@localhost:5432/buddhist_world
REDIS_URL=redis://localhost:6379
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# This placeholder is intentionally invalid for production. Replace it in your local .env.
JWT_ACCESS_SECRET=CHANGE_ME_generate_a_unique_random_secret_at_least_32_chars
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000
COOKIE_SECURE=false

# Authoritative world weather; visual weather particles are a separate client effect.
WORLD_WEATHER=clear
WORLD_WEATHER_INTENSITY=0

# Optional: GLB character model with Idle/Walk/Run/Jump animation clips.
# Example: /assets/characters/player.glb (leave blank to use procedural placeholder).
VITE_PLAYER_MODEL_URL=

# Optional: rigged NPC GLB. Supports idle/walk/talk/pray/work/rest clip aliases.
# Leave blank until a skinned NPC asset has passed GLB and in-game visual validation.
VITE_NPC_MODEL_URL=

# Optional world ambience audio. Playback starts only after a user gesture and pauses when the tab is hidden.
# Keep blank until a licensed/approved ambience file is available.
VITE_WORLD_AMBIENCE_URL=

# Optional world intro video. Keep blank until an approved intro video is available.
# Supports browser-native video formats; the player provides play, skip and failure fallback.
VITE_WORLD_INTRO_VIDEO_URL=

# Optional WebRTC TURN (Coturn REST credentials are generated server-side)
TURN_URLS=
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SEC=600
