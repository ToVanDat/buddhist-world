# Copy to .env. Never commit .env or production credentials.
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (backend runs on Windows; Docker exposes host port 5433)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=buddhist_world
DB_USER=postgres
# Local development default only. Change this together with the initialized DB role when needed.
DB_PASSWORD=postgres

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_generate_a_unique_random_secret_at_least_32_chars
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000
COOKIE_SECURE=false

# Authoritative world weather
WORLD_WEATHER=clear
WORLD_WEATHER_INTENSITY=0

# Optional character models. Leave blank until real GLB files are validated.
VITE_PLAYER_MODEL_URL=
VITE_NPC_MODEL_URL=

# Optional world ambience and intro video. Leave blank until approved assets exist.
VITE_WORLD_AMBIENCE_URL=
VITE_WORLD_INTRO_VIDEO_URL=

# Optional WebRTC TURN. Leave blank while TURN is not configured.
TURN_URLS=
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SEC=600
